rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'email'])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'phone', 'cityId', 'driverType',
          'avatarUrl', 'isVerified', 'joinedLabel', 'isOnline',
          'latitude', 'longitude', 'heading', 'todayEarnings',
          'todayTripsCount', 'bankBalance', 'insuranceCoverage',
          'insuranceExpiry', 'documentExpiries', 'fcmToken',
          'insuredVehiclePlate', 'insuredVehicleModel', 'additionalDrivers',
          'documentsUploaded', 'faceVerified'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('cityId' in data) || (data.cityId is string && data.cityId.size() <= 40))
        && (!('driverType' in data) || data.driverType in ['Independent', 'Fleet'])
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && (!('heading' in data) || data.heading is number)
        && (!('todayEarnings' in data) || (data.todayEarnings is number && data.todayEarnings >= 0))
        && (!('todayTripsCount' in data) || (data.todayTripsCount is number && data.todayTripsCount >= 0))
        && (!('bankBalance' in data) || (data.bankBalance is number && data.bankBalance >= 0))
        && (!('insuranceCoverage' in data) || data.insuranceCoverage in ['taxi', 'food', 'all'])
        && (!('insuranceExpiry' in data) || (data.insuranceExpiry is string && data.insuranceExpiry.size() <= 32))
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    match /users/{userId} {
      // Strictly isolate PII and driver metrics to the authenticated owner
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.auth.token.email_verified == true
        && isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId)
        && request.auth.token.email_verified == true
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'email', 'phone', 'cityId', 'driverType',
          'avatarUrl', 'isVerified', 'joinedLabel', 'isOnline',
          'latitude', 'longitude', 'heading', 'todayEarnings',
          'todayTripsCount', 'bankBalance', 'insuranceCoverage',
          'insuranceExpiry', 'documentExpiries', 'fcmToken',
          'insuredVehiclePlate', 'insuredVehicleModel', 'additionalDrivers',
          'documentsUploaded', 'faceVerified'
        ]);

      allow delete: if isOwner(userId);
    }
  }
}
